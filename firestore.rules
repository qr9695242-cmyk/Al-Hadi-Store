rules_version = '2';

// ============================================================================
// Al Hadi Store — Firestore Security Rules
// ============================================================================
// Setup checklist (required before these rules will work):
//   1. Firebase Console > Authentication > Sign-in method > enable
//      "Email/Password" and "Google".
//   2. Firebase Console > Authentication > Users > add one user with the
//      exact email in ADMIN_EMAIL below (must match js/app.js ADMIN_EMAIL).
//   3. Deploy with: firebase deploy --only firestore:rules
// Without step 1, both signup and login fail with auth/configuration-not-found.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Keep this in sync with ADMIN_EMAIL in js/app.js.
      return request.auth != null && request.auth.token.email == 'qraza2376@gmail.com';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Products — public read (needed to browse the storefront), write
    // restricted to the admin account only. Previously "write: if true",
    // which let anyone add/edit/delete products directly from the browser
    // console; that hole is closed here.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Per-user documents (liked products, profile fields). Each user can
    // only read/write their own document, never anyone else's.
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      match /addresses/{addressId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Orders — checkout works without an account (guest checkout is a
    // supported flow), so "create" stays open. Status changes are admin-
    // only, except two customer-initiated fields (cancel/return requests)
    // which a customer can set on their own order without touching
    // anything else.
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['cancelRequested', 'cancelRequestedAt', 'returnRequested', 'returnReason', 'returnRequestedAt', 'customerFcmToken']);
      allow delete: if isAdmin();
    }

    // Admin push-notification tokens (Firebase Cloud Messaging). Only the
    // admin account itself can register/read/remove its own device tokens —
    // /api/notify.js reads this collection with the Admin SDK, which
    // bypasses these rules entirely (server-side, not a browser client).
    match /admin_tokens/{tokenId} {
      allow read, write: if isAdmin();
    }

    // Aggregate analytics counters (site visits, product views, add-to-cart
    // counts) — no personal data. Full admin access always allowed, but
    // trackEvent() in app.js also writes these same counters directly from
    // anonymous/logged-out visitors (that's the whole point of visit
    // tracking), so a plain isAdmin()-only rule would silently block every
    // one of those writes. This lets anyone increment only the known
    // counter fields — nothing else can be created or changed this way.
    match /analytics/{docId} {
      allow read: if true;
      allow write: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(
        ['lastUpdated', 'totalPageViews', 'totalProductViews', 'productViews', 'totalAddToCart', 'productAddToCart']);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(
        ['lastUpdated', 'totalPageViews', 'totalProductViews', 'productViews', 'totalAddToCart', 'productAddToCart']);
    }

    // Homepage hero banners — public read, admin-only write.
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons — customers may fetch one specific code by id (to validate it
    // at checkout) but can't list/browse the full collection. The only
    // field a non-admin write may touch is usedCount, so a customer can
    // never grant themselves a bigger discount by editing a coupon.
    match /coupons/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount']);
    }

    // Product reviews — anyone can submit a review (no login required, same
    // as orders), but the write must look like a real review: an integer
    // rating from 1-5 and a valid productId. Editing/removing reviews
    // (e.g. spam moderation) is admin-only.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.productId is string;
      allow update, delete: if isAdmin();
    }

    // Marketplace seller applications are private to the applicant; admins
    // can review and transition status. Clients cannot self-approve.
    match /sellerApplications/{sellerId} {
      allow get: if isSignedIn() && (request.auth.uid == sellerId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == sellerId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == sellerId
        && request.resource.data.uid == sellerId
        && request.resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    // Seller product submissions remain private until an admin approves them.
    match /sellerProducts/{productId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.sellerId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin() || (isSignedIn() && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'pending');
      allow delete: if isAdmin() || (isSignedIn() && resource.data.sellerId == request.auth.uid);
    }

    // Public shop profiles can only be published by an admin.
    match /shops/{shopId} {
      allow get: if resource.data.status == 'approved' || isAdmin() || (isSignedIn() && resource.data.sellerId == request.auth.uid);
      allow list: if true;
      allow write: if isAdmin() || (isSignedIn() && request.resource.data.sellerId == request.auth.uid);
    }

    // Everything else is denied by default (Firestore rules deny anything
    // not explicitly matched above), stated here for clarity.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
