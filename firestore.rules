rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email == 'qraza2376@gmail.com';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Products
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users
    match /users/{userId} {
      allow read, write: if isSignedIn() &&
                          request.auth.uid == userId;

      match /addresses/{addressId} {
        allow read, write: if isSignedIn() &&
                            request.auth.uid == userId;
      }
    }

    // Orders
    match /orders/{orderId} {
      allow get, create: if true;

      // Guest order tracking now looks up a single order by its exact
      // (unguessable) Order ID via get() and checks the phone client-side —
      // it no longer needs to list/query the collection, so bulk listing
      // is restricted to the admin dashboard only.
      allow list: if isAdmin();

      allow update: if isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'cancelRequested',
          'cancelRequestedAt',
          'returnRequested',
          'returnReason',
          'returnRequestedAt'
        ]);

      allow delete: if isAdmin();
    }

    // Analytics — create and update are split apart on purpose.
    // On create, no prior document exists yet, so "resource" is null and
    // "resource.data" cannot be read (that was the bug: a single
    // create+update rule that called resource.data.diff(...) crashed with
    // "Missing or insufficient permissions" on the very first write to a
    // fresh analytics/summary document). create checks the new data's own
    // keys instead; update still safely diffs against the existing doc.
    match /analytics/{docId} {
      allow read: if true;

      allow create: if docId == "summary" &&
        request.resource.data.keys().hasOnly([
          'lastUpdated',
          'totalPageViews',
          'totalProductViews',
          'totalAddToCart',
          'productViews',
          'productAddToCart'
        ]);

      allow update: if docId == "summary" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastUpdated',
          'totalPageViews',
          'totalProductViews',
          'totalAddToCart',
          'productViews',
          'productAddToCart'
        ]);

      allow delete: if isAdmin();
    }

    // Banners
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons
    match /coupons/{code} {
      allow get: if true;
      allow list, create, delete: if isAdmin();

      allow update: if isAdmin() ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'usedCount'
          ]) &&
          request.resource.data.usedCount ==
          resource.data.usedCount + 1
        );
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.productId is string;

      allow update, delete: if isAdmin();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
